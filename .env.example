# Copy to .env and fill in. Never commit .env.
POLLINEX_ENV=development
# Local dev uses SQLite by default (backend/pollinex.db). Docker/production uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pollinex:CHANGE_ME@localhost:5432/pollinex
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=15
# Optional Open-Meteo integration (free, no API key)
WEATHER_API_ENABLED=true
# Optional: create an admin on first start (otherwise the first registered account becomes admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Frontend (only when the API is on another origin, e.g. Vercel + Render)
VITE_API_URL=

# Rate limiting for login/register/uploads (single-process limiter)
RATE_LIMIT_ENABLED=true
# true = create tables on startup (SQLite dev); false = use `alembic upgrade head` (PostgreSQL)
AUTO_CREATE_TABLES=true
