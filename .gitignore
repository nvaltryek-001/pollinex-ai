# secrets
.env
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
*.egg-info/

# node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# runtime data
backend/pollinex.db
backend/storage/
*.sqlite3

# datasets: never commit raw/processed image archives (use the scripts)
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
# committed on purpose: small, redistributable (CC BY 4.0) processed sets so a fresh clone can train/evaluate offline
!datasets/processed/usda_fruit_flower/
!datasets/processed/usda_fruit_flower_index.csv
!datasets/processed/tf_flower_detection_sunflower/
!datasets/processed/sunflower_gallery/

# training artefacts (small deployed models in ai-engine/models are committed deliberately)
ai-engine/runs/
*.pt
*.onnx
!ai-engine/models/.gitkeep

.DS_Store
.idea/
.vscode/
frontend/e2e-screenshots/
